{
  "$schema": "https://raw.githubusercontent.com/adlerluiz/azoth/main/schemas/driver.schema.json",
  "schemaVersion": "2.0.0",
  "version": "1.0.0",
  "id": "codex",
  "name": "OpenAI Codex",
  "category": "CLI / Agent",
  "vendor": "OpenAI",
  "author": "OpenAI",
  "description": "Agente autônomo de código e modelo da OpenAI para execução de instruções, automação e geração de software.",
  "capabilities": {
    "skills": true,
    "modularRules": true,
    "consolidatedRules": true,
    "mcp": true,
    "profiles": true,
    "slashCommands": false
  },
  "rules": {
    "mode": "both",
    "consolidatedFile": "AGENTS.md",
    "modularPattern": ".agents/rules/<name>.md",
    "format": "yaml_frontmatter",
    "globalLocation": {
      "darwin": "~/.codex/rules/",
      "linux": "~/.codex/rules/",
      "windows": "%USERPROFILE%\\.codex\\rules\\"
    }
  },
  "skills": {
    "symlinkMode": "file",
    "workspaceLocation": ".agents/skills/<name>/SKILL.md",
    "globalLocation": {
      "darwin": "~/.codex/skills/",
      "linux": "~/.codex/skills/",
      "windows": "%USERPROFILE%\\.codex\\skills\\"
    }
  },
  "mcp": {
    "rootKey": "mcpServers",
    "workspaceLocation": "codex.json",
    "globalLocation": {
      "darwin": "~/.codex/config.json",
      "linux": "~/.codex/config.json",
      "windows": "%USERPROFILE%\\.codex\\config.json"
    },
    "format": "json",
    "supportsEnvResolution": true
  },
  "processNames": ["codex", "openai"],
  "globalBrainPath": "~/.codex",
  "globalCachePath": "~/.codex/logs",
  "osDetectedPaths": {
    "darwin": [
      "~/.codex",
      "/usr/local/bin/codex",
      "/opt/homebrew/bin/codex",
      "~/.openai"
    ],
    "windows": [
      "%USERPROFILE%\\.codex",
      "%APPDATA%\\Codex",
      "%USERPROFILE%\\.openai"
    ],
    "linux": [
      "~/.codex",
      "/usr/bin/codex",
      "/usr/local/bin/codex",
      "~/.openai"
    ]
  },
  "detectedPaths": [
    "~/.codex"
  ],
  "docsUrl": "https://platform.openai.com/docs/guides/code",
  "badgeColor": "bg-emerald-500/10 text-emerald-400 border-emerald-500/30",
  "isBuiltin": true,
  "icon": "logo.png"
}
