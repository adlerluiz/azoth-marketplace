{
  "$schema": "https://raw.githubusercontent.com/adlerluiz/azoth/main/schemas/driver.schema.json",
  "schemaVersion": "1.0.0",
  "version": "1.0.0",
  "id": "claude",
  "name": "Claude Code & Desktop",
  "vendor": { "id": "anthropic", "name": "Anthropic" },
  "surface": "cli",
  "author": "Adler Luiz",
  "description": "Official Claude Code CLI and Claude Desktop app, with support for CLAUDE.md, ~/.claude.json, and MCP servers.",
  "capabilities": {
    "skills": true,
    "modularRules": true,
    "consolidatedRules": true,
    "mcp": true,
    "profiles": true,
    "slashCommands": false
  },
  "rules": {
    "mode": "both",
    "consolidatedFile": "CLAUDE.md",
    "modularPattern": ".claude/rules/<name>.md",
    "format": "markdown",
    "globalLocation": {
      "darwin": "~/.claude/CLAUDE.md",
      "linux": "~/.claude/CLAUDE.md",
      "windows": "%USERPROFILE%\\.claude\\CLAUDE.md"
    }
  },
  "skills": {
    "symlinkMode": "file",
    "workspaceLocation": ".claude/skills/<name>/SKILL.md",
    "globalLocation": {
      "darwin": "~/.claude/skills/",
      "linux": "~/.claude/skills/",
      "windows": "%USERPROFILE%\\.claude\\skills\\"
    }
  },
  "mcp": {
    "rootKey": "mcpServers",
    "workspaceLocation": ".claude/mcp.json",
    "globalLocation": {
      "darwin": "~/Library/Application Support/Claude/claude_desktop_config.json",
      "windows": "%APPDATA%\\Claude\\claude_desktop_config.json",
      "linux": "~/.config/Claude/claude_desktop_config.json"
    },
    "format": "json",
    "supportsEnvResolution": true
  },
  "processNames": ["Claude", "claude"],
  "globalBrainPath": "~/.claude",
  "globalCachePath": "~/Library/Application Support/Claude",
  "osDetectedPaths": {
    "darwin": [
      "/Applications/Claude.app",
      "/usr/local/bin/claude",
      "/opt/homebrew/bin/claude",
      "~/Library/Application Support/Claude",
      "~/.claude"
    ],
    "windows": [
      "%LOCALAPPDATA%\\Programs\\Claude\\Claude.exe",
      "%APPDATA%\\Claude\\claude_desktop_config.json",
      "%USERPROFILE%\\.claude"
    ],
    "linux": [
      "/usr/bin/claude",
      "~/.config/Claude/claude_desktop_config.json",
      "~/.claude"
    ]
  },
  "detectedPaths": [
    "/Applications/Claude.app",
    "/usr/local/bin/claude",
    "/opt/homebrew/bin/claude",
    "~/.claude"
  ],
  "docsUrl": "https://docs.anthropic.com",
  "badgeColor": "bg-amber-500/10 text-amber-400 border-amber-500/30",
  "icon": "logo.png"
}
