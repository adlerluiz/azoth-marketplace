{
  "$schema": "https://raw.githubusercontent.com/adlerluiz/azoth/main/schemas/driver.schema.json",
  "schemaVersion": "2.0.0",
  "version": "1.0.0",
  "id": "agy",
  "name": "Agy",
  "category": "CLI / Agent",
  "vendor": "Google",
  "author": "DeepMind",
  "description": "Interface de Linha de Comando (CLI) oficial do Antigravity (AGY) para terminal com suporte a slash commands, subagentes e customizações.",
  "capabilities": {
    "skills": true,
    "modularRules": true,
    "consolidatedRules": true,
    "mcp": true,
    "profiles": true,
    "slashCommands": true
  },
  "rules": {
    "mode": "both",
    "consolidatedFile": "AGENTS.md",
    "modularPattern": ".agents/rules/<name>.md",
    "format": "agents_md",
    "globalLocation": {
      "darwin": "~/.gemini/config/rules/",
      "linux": "~/.gemini/config/rules/",
      "windows": "%USERPROFILE%\\.gemini\\config\\rules\\"
    }
  },
  "skills": {
    "symlinkMode": "file",
    "workspaceLocation": ".agents/skills/<name>/SKILL.md",
    "globalLocation": {
      "darwin": "~/.gemini/skills/",
      "linux": "~/.gemini/skills/",
      "windows": "%USERPROFILE%\\.gemini\\skills\\"
    }
  },
  "mcp": {
    "rootKey": "mcpServers",
    "workspaceLocation": "mcp.json",
    "globalLocation": "~/.gemini/antigravity-cli/settings.json",
    "format": "json",
    "supportsEnvResolution": true
  },
  "processNames": ["agy", "antigravity-cli"],
  "globalBrainPath": "~/.gemini/antigravity-cli/brain",
  "globalCachePath": "~/.gemini/antigravity-cli/log",
  "osDetectedPaths": {
    "darwin": [
      "/usr/local/bin/agy",
      "/opt/homebrew/bin/agy",
      "~/.gemini/antigravity-cli",
      "~/.antigravity"
    ],
    "windows": [
      "%LOCALAPPDATA%\\agy\\bin\\agy.exe",
      "%LOCALAPPDATA%\\Programs\\agy\\agy.exe",
      "%USERPROFILE%\\.gemini\\antigravity-cli"
    ],
    "linux": [
      "/usr/bin/agy",
      "/usr/local/bin/agy",
      "~/.gemini/antigravity-cli",
      "~/.antigravity"
    ]
  },
  "detectedPaths": [
    "%LOCALAPPDATA%\\agy\\bin\\agy.exe",
    "/usr/local/bin/agy",
    "/opt/homebrew/bin/agy",
    "~/.gemini/antigravity-cli"
  ],
  "docsUrl": "https://antigravity.google/docs/cli/reference",
  "badgeColor": "bg-sky-500/10 text-sky-400 border-sky-500/30",
  "isBuiltin": true,
  "icon": "logo.png"
}
