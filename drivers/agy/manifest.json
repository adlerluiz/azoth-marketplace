{
  "$schema": "https://raw.githubusercontent.com/adlerluiz/ai-hub/main/schemas/driver.schema.json",
  "schemaVersion": "1.0.0",
  "version": "1.0.1",
  "id": "agy",
  "name": "Antigravity CLI (AGY)",
  "category": "CLI / Agent",
  "vendor": "Google",
  "author": "DeepMind",
  "description": "Interface de Linha de Comando (CLI) oficial do Antigravity (AGY) para terminal com suporte a slash commands, subagentes e customizações em ~/.gemini/antigravity-cli/.",
  "agentsFormat": "agents_md",
  "rulesFormat": "yaml_frontmatter",
  "workspaceAgentsLocation": "AGENTS.md",
  "workspaceModularAgentsLocation": ".agents/rules/<name>.md",
  "workspaceRulesLocation": "AGENTS.md",
  "workspaceSkillsLocation": ".agents/skills/<name>/SKILL.md",
  "workspaceMcpConfigPath": "mcp.json",
  "globalRulesPath": "~/.gemini/config/rules/",
  "globalSkillsPath": "~/.gemini/skills/",
  "globalConfigPath": "~/.gemini/antigravity-cli/settings.json",
  "globalBrainPath": "~/.gemini/antigravity-cli/brain",
  "globalCachePath": "~/.gemini/antigravity-cli/log",
  "osDetectedPaths": {
    "darwin": [
      "/usr/local/bin/agy",
      "/opt/homebrew/bin/agy",
      "~/.gemini/antigravity-cli",
      "~/.antigravity"
    ],
    "windows": [
      "%LOCALAPPDATA%\\agy\\bin\\agy.exe",
      "%LOCALAPPDATA%\\Programs\\agy\\agy.exe",
      "%USERPROFILE%\\.gemini\\antigravity-cli"
    ],
    "linux": [
      "/usr/bin/agy",
      "/usr/local/bin/agy",
      "~/.gemini/antigravity-cli",
      "~/.antigravity"
    ]
  },
  "detectedPaths": [
    "%LOCALAPPDATA%\\agy\\bin\\agy.exe",
    "/usr/local/bin/agy",
    "/opt/homebrew/bin/agy",
    "~/.gemini/antigravity-cli"
  ],
  "docsUrl": "https://antigravity.google/docs/cli/reference",
  "badgeColor": "bg-sky-500/10 text-sky-400 border-sky-500/30",
  "isBuiltin": true,
  "icon": "logo.png"
}
